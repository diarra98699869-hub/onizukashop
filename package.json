{
  "name": "onizukashop-mobile",
  "version": "1.0.0",
  "description": "Application Mobile Native (Capacitor Android/iOS) & PWA Pro pour ONIZUKA SHOP (Grand Marché de Bamako, Dibidani)",
  "private": true,
  "scripts": {
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:assets": "npx @capacitor/assets generate --iconBackgroundColor #0d0e12 --splashBackgroundColor #0d0e12",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "apk:debug": "cd android && gradlew assembleDebug",
    "apk:release": "cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/network": "^6.0.2",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0"
  }
}
